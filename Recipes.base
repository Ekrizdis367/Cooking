filters:
  and:
    - file.inFolder("Cooking")
formulas:
  flat_ingredients: list(Ingredients).flat().sort().unique()
  ing: |
    ingredients
      .map('- [ ] ' + if(value.amount, value.amount + ' ', '') + value.name)
properties:
  file.name:
    displayName: Meal
  category:
    displayName: Category
  Ingredients:
    displayName: Ingredients
  formula.flat_ingredients:
    displayName: Combined Ingredients
  file.mtime:
    displayName: Last Cooked
views:
  - type: cards
    name: Dinners [Card]
    filters:
      and:
        - file.inFolder("Cooking/Dinners")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
    image: note.image
  - type: cards
    name: Breakfasts [Card]
    filters:
      or:
        - file.inFolder("Cooking/Breakfasts")
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
      - property: Cook
        direction: ASC
    image: note.image
  - type: cards
    name: Baking [Card]
    filters:
      or:
        - file.inFolder("Cooking/Baking")
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
      - property: Cook
        direction: ASC
    image: note.image
  - type: cards
    name: All [Card]
    filters:
      or:
        - file.inFolder("Cooking/Dinners")
        - file.inFolder("Cooking/Breakfasts")
        - file.inFolder("Cooking/Baking")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
      - property: Cook
        direction: ASC
    image: note.image
  - type: cards
    name: Drinks [Card]
    filters:
      or:
        - file.inFolder("Cooking/Drinks")
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
      - property: Cook
        direction: ASC
    image: note.image
  - type: table
    name: All [Table]
    order:
      - file.name
      - category
      - protein
      - fat
      - carbs
      - calories
      - totalTime
    columnSize:
      file.name: 251
      note.image: 826
  - type: cards
    name: Snacks
    filters:
      and:
        - file.inFolder("Cooking/Snacks")
    order:
      - file.name
      - Cook
    sort:
      - property: file.name
        direction: ASC
    image: note.image
  - type: cards
    name: By Type [Card]
    filters:
      and:
        - 'category != ""'
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - category
    sort:
      - property: file.name
        direction: ASC
    image: note.image
  - type: cards
    name: BBQ
    filters:
      and:
        - category == "bbq"
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.image
  - type: cards
    name: Soup
    filters:
      and:
        - category == "soup"
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.image
  - type: cards
    name: Pasta
    filters:
      and:
        - category == "pasta"
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.image
  - type: cards
    name: Mexican
    filters:
      and:
        - category == "mexican"
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.image
  - type: cards
    name: Asian
    filters:
      and:
        - category == "asian"
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.image
